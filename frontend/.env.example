# ====================================================================
# FRONTEND ENVIRONMENT VARIABLES
# ====================================================================
# Copy this file to .env and fill in the values
# For Vite, environment variables must be prefixed with VITE_ or REACT_APP_

# Backend URL (REQUIRED)
# Production: https://powerprecisionzia-backend.onrender.com
# Development: http://localhost:8000
REACT_APP_BACKEND_URL=https://powerprecisionzia-backend.onrender.com

# Optional: Google Analytics
# REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X
