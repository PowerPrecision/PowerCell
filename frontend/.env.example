# ====================================================================
# PowerCell frontend — exemplo de configuração (.env)
# ====================================================================
# Copie para `.env` e ajuste. NÃO faça commit do `.env` real.
# Vite expõe variáveis com prefixo REACT_APP_ (compat CRA) e VITE_.
# ====================================================================

# URL do backend FastAPI (dev local)
REACT_APP_BACKEND_URL=http://localhost:8001

# ── Opcional: Observabilidade (Sentry) ─────────────────────────────
# VITE_DSN_SENTRY_FRONTEND=
# VITE_ENVIRONMENT=dev

# ── Opcional: upload de source maps no build de produção ───────────
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=power-precision
# SENTRY_PROJECT=powercell-frontend
