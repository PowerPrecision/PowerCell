# ====================================================================
# PowerCell backend — exemplo de configuração (.env)
# ====================================================================
# Copie este ficheiro para `.env` e preencha os valores.
# NUNCA faça commit do `.env` real (está no .gitignore).
# Gere segredos com: openssl rand -hex 32
# ====================================================================

# ── OBRIGATÓRIO ─────────────────────────────────────────────────────
# Ligação MongoDB. Para dev local: mongodb://localhost:27017
MONGO_URL=mongodb://localhost:27017
DB_NAME=PowerCell_dev
# JWT: mínimo 32 caracteres, alta entropia (openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# Origens CORS permitidas (separadas por vírgula). NÃO usar "*".
CORS_ORIGINS=http://localhost:3000
# Chave de encriptação AES/Fernet para dados PII (openssl rand -hex 32)
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# ── Ambiente ────────────────────────────────────────────────────────
ENVIRONMENT=dev
Port=8001
WEB_CONCURRENCY=1

# ── Passwords de seed (obrigatórias ao correr seed.py) ──────────────
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password
SEED_DEFAULT_PASSWORD=CHANGE_ME_strong_password

# ── Opcional: Cache/Fila (Redis / Upstash) ─────────────────────────
# REDIS_URL alimenta DUAS coisas: a fila ARQ e o Pub/Sub de eventos
# (WebSockets em tempo real). Sem ele, o sistema degrada: as tarefas
# continuam a correr e o frontend volta ao polling.
# REDIS_URL=redis://localhost:6379
# Canal do Pub/Sub de eventos (isolar staging/produção no mesmo Redis):
# SYSTEM_EVENTS_CHANNEL=powercell_system_events
# Upstash é REST — serve o CACHE, não suporta Pub/Sub. Os dois coexistem.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Opcional: Armazenamento S3 (AWS) ────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-north-1
# AWS_BUCKET_NAME=

# ── Opcional: IA ────────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_ORGANIZATION_ID=
# OPENAI_DATA_TRAINING_OPT_OUT=true
# GEMINI_API_KEY=
# EMERGENT_LLM_KEY=

# ── Opcional: Email (transacional + IMAP/SMTP) ─────────────────────
# EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=
# EMAIL_FROM=noreply@example.com
# DISABLE_EMAIL_SYNC=true
# EMAIL_SYNC_ENABLED=false
# EMAIL_AUTO_SYNC_INTERVAL_SECONDS=60
# POWER_EMAIL=
# POWER_PASSWORD=
# POWER_IMAP_SERVER=
# POWER_IMAP_PORT=993
# POWER_SMTP_SERVER=
# POWER_SMTP_PORT=465
# PRECISION_EMAIL=
# PRECISION_PASSWORD=
# PRECISION_IMAP_SERVER=
# PRECISION_IMAP_PORT=993
# PRECISION_SMTP_SERVER=
# PRECISION_SMTP_PORT=465

# ── Opcional: Google OAuth (Gmail) ──────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# ── Opcional: Integrações várias ────────────────────────────────────
# SCRAPERAPI_API_KEY=
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# TRELLO_BOARD_ID=
# ONEDRIVE_WEBHOOK_URL=

# ── Opcional: Observabilidade (Sentry) ─────────────────────────────
# DSN_SENTRY_BACKEND=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_AUTH_TOKEN=

# ====================================================================
# NOTAS DE VOZ DO CONSULTOR (Épico 7)
# ====================================================================
# Motor de transcrição: "openai" ou "mock".
# Sem esta variável, usa "openai" apenas em produção COM chave de API
# configurada; em qualquer outro caso simula (dev nunca chama API paga
# nem envia a voz de ninguém para fora).
# VOICE_ASR_PROVIDER=mock
# VOICE_ASR_MODEL=whisper-1
# VOICE_ASR_TIMEOUT=120
#
# Motor de extração (resumo + tarefas). Sem variável, segue o do ASR.
# VOICE_LLM_PROVIDER=mock
# Sem VOICE_LLM_MODEL, o modelo vem do painel de administração
# (chave `voice_note_extraction`).
# VOICE_LLM_MODEL=gpt-4o-mini
# VOICE_LLM_TIMEOUT=90
#
# Tamanho máximo da gravação aceite pelo endpoint, em MB.
# VOICE_NOTE_MAX_MB=25
