# ====================================================================
# DOCKERFILE.WORKER - POWERCELL BACKGROUND WORKER
# ====================================================================
# Mesma imagem base que o backend (Playwright + Chromium) para permitir
# que o worker também execute o scraper se necessário.
#
# A ÚNICA diferença é o CMD: em vez de uvicorn, corre o worker.py
# que processa tarefas assíncronas e o scheduler (webmail sync,
# lead matching, trello sync, etc.).
#
# O worker SÓ arranca quando ENVIRONMENT=production (kill switch
# interno em worker.py). Em DEV, sai imediatamente sem gastar RAM.
# ====================================================================

FROM mcr.microsoft.com/playwright/python:v1.52.0-noble

# Prevent interactive prompts (tzdata, etc.)
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC

# ── Variáveis de ambiente ──
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    APP_ENV=production

# ── Dependências de runtime adicionais ──
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ── Working directory ──
WORKDIR /app

# ── Instalar dependências Python ──
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Copiar código da aplicação ──
COPY . .

# ── Permissões ──
RUN chown -R pwuser:pwuser /app

# ── Mudar para utilizador não-root ──
USER pwuser

# ── Comando de arranque — WORKER ──
# O worker.py tem kill switch: só arranca em ENVIRONMENT=production.
# Em DEV, sai imediatamente sem criar event loop (poupa RAM).
CMD ["python", "worker.py"]
