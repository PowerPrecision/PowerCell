# =====================================================================
# PowerCell CRM — Variáveis de Ambiente (Exemplo)
# =====================================================================
# Copie este ficheiro para .env e preencha os valores reais.
# NÃO commite o ficheiro .env para o repositório.
# =====================================================================

# =====================================================================
# AMBIENTE (obrigatório)
# =====================================================================
# Define o ambiente de execução. Afeta validações de segurança
# (ex.: JWT_SECRET é mais restritivo em produção).
# Valores permitidos: production, development, dev, local, preview
# =====================================================================
ENVIRONMENT=development

# =====================================================================
# JWT — Autenticação (obrigatório)
# =====================================================================
# Chave secreta para assinar e verificar tokens JWT.
# Mínimo 32 caracteres. Gere com: openssl rand -hex 32
# Em produção, valores de exemplo são bloqueados.
# =====================================================================
JWT_SECRET=your-jwt-secret-here-minimum-32-chars

# =====================================================================
# BASE DE DADOS (obrigatório)
# =====================================================================
# URL de conexão MongoDB (Motor async).
# Recomendado usar MongoDB Atlas com connection string SRV.
# Exemplo: mongodb+srv://user:password@cluster.xxxxx.mongodb.net
# =====================================================================
MONGO_URL=your-mongodb-url-here
DB_NAME=powercell

# =====================================================================
# CORS — Controlo de Origens (obrigatório)
# =====================================================================
# Lista de origens permitidas, separadas por vírgulas.
# DEVE usar HTTPS em produção. Wildcards (*) são BLOQUEADOS.
# Exemplo: https://powercell.pt,https://app.powercell.pt
# Em desenvolvimento pode usar http://localhost:3000
# =====================================================================
CORS_ORIGINS=https://your-domain.com

# Variantes automáticas (www/non-www) são adicionadas automaticamente.
# Preview domains do Vercel são permitidos por defeito.
# Opções avançadas (raramente necessárias):
# CORS_ALLOW_CREDENTIALS=true
# CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
# CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With
# CORS_MAX_AGE=600
# ALLOW_VERCEL_PREVIEWS=true

# =====================================================================
# SENTRY — Observabilidade (opcional)
# =====================================================================
# Se não definido, o Sentry fica desativado (não envia dados).
# DSN obtido em: https://sentry.io → Project Settings → Client Keys
# =====================================================================
DSN_SENTRY_BACKEND=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# =====================================================================
# AWS S3 — Armazenamento de Ficheiros (opcional mas recomendado)
# =====================================================================
# Utilizado para: uploads de documentos, backups automáticos,
# pre-signed URLs, restauração de Dev a partir de backups.
# Obtido em: https://console.aws.amazon.com/iam/
# =====================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=

# =====================================================================
# EMAIL — Envio de Emails Transacionais (opcional)
# =====================================================================
# Provedor primário: sendgrid ou resend (recomendado).
# SMTP mantido como fallback de emergência.
# Se não configurado, emails são simulados (apenas logged).
# =====================================================================
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=
EMAIL_FROM=noreply@powerealestate.pt
EMAIL_FROM_NAME=Power Real Estate & Precision Crédito

# SMTP Fallback (legado — usar apenas se SendGrid/Resend indisponível)
SMTP_SERVER=
SMTP_PORT=465
SMTP_EMAIL=
SMTP_PASSWORD=

# =====================================================================
# REDIS — Cache e Fila de Tarefas (opcional)
# =====================================================================
# Utilizado para: cache de estatísticas, fila ARQ para tarefas
# em background (análise IA, etc.).
# Se não definido ou for localhost, Redis é tratado como opcional.
# Exemplo Upstash: rediss://default:token@host:port
# =====================================================================
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# Configuração do worker ARQ (raramente necessário alterar)
TASK_JOB_TIMEOUT=300
TASK_MAX_TRIES=3
TASK_RETRY_DELAY=60
TASK_MAX_JOBS=10

# =====================================================================
# IA — Inteligência Artificial (opcional)
# =====================================================================
# Chaves para provedores de IA (análise de documentos, extração de dados).
# Pode configurar um ou mais provedores. O sistema seleciona o modelo
# automaticamente baseado no tipo de tarefa.
# =====================================================================
# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=
OPENAI_ORGANIZATION_ID=
OPENAI_DATA_TRAINING_OPT_OUT=true

# Emergent LLM (alternativa OpenAI para GPT-4o/4o-mini)
EMERGENT_LLM_KEY=

# Google Gemini (Flash 2.0 — económico para scraping e extração)
GEMINI_API_KEY=

# =====================================================================
# ONEDRIVE — Integração OneDrive (opcional)
# =====================================================================
# Utilizado para sincronização com OneDrive for Business.
# Credenciais de aplicação Azure AD.
# =====================================================================
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_BASE_PATH=Documentação Clientes

# =====================================================================
# TRELLO — Integração Trello (opcional)
# =====================================================================
# Utilizado para sincronização de processos com quadros Trello.
# =====================================================================
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# =====================================================================
# SINCRONIZAÇÃO PRODUÇÃO ↔ DESENVOLVIMENTO (opcional)
# =====================================================================
# Variáveis utilizadas pelos pipelines de sincronização:
#   - restore_dev_from_backup.py (restaura Dev a partir de S3 backup)
#   - sync_prod_to_dev.py (copia Prod → Dev com anonimização RGPD)
#
# Se PROD_MONGO_URL não estiver definido, usa MONGO_URL como fallback.
# =====================================================================
PROD_MONGO_URL=
PROD_DB_NAME=
DEV_MONGO_URL=
DEV_DB_NAME=

# =====================================================================
# BACKUP — Configuração de Backups Automáticos (opcional)
# =====================================================================
# Ajustes de retenção e limites para backups.
# Os backups automáticos correm diariamente às 03:00 UTC.
# =====================================================================
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_CLOUD_RETENTION_DAYS=30
BACKUP_MAX_SIZE_MB=500
ONEDRIVE_BACKUP_FOLDER=Backups

# =====================================================================
# FRONTEND — Variáveis do Frontend React
# =====================================================================
# Estas variáveis são lidas pelo frontend via process.env
# (prefixo REACT_APP_) ou import.meta.env (prefixo VITE_).
# Coloque no ficheiro .env da pasta frontend/ ou nas variáveis
# de ambiente do Vercel.
# =====================================================================

# URL do backend API (sem trailing slash)
REACT_APP_BACKEND_URL=https://your-backend.onrender.com

# Ambiente do frontend (afeta comportamento de algumas funcionalidades)
REACT_APP_ENVIRONMENT=development

# Chave pública VAPID para Push Notifications (Web Push API)
REACT_APP_VAPID_PUBLIC_KEY=

# Sentry — Frontend (preferido usar VITE_DSN_SENTRY_FRONTEND)
VITE_DSN_SENTRY_FRONTEND=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_SEND_DEFAULT_PII=false
