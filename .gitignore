# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
.env
.env.*
*.env
credentials.json
*.key
.credentials
.repo-config

# Python bytecode cache (não deve ser committed)
__pycache__/
*.py[cod]
*$py.class
*.so

# PowerCell working dirs
/powercell/__pycache__/
/powercell/**/__pycache__/
/powercell/dev.log

# Coverage data (não deve ser committed)
.coverage
**/.coverage
coverage.xml
**/coverage.xml

# Permitir templates de exemplo de env (têm de ser versionados)
!.env.example
!**/.env.example
